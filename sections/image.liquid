{% if block.settings.src != "" %}
<figure class="sz-image">
  {% if block.settings.link != "" %}<a href="{{ block.settings.link }}">{% endif %}
  <img src="{{ block.settings.src }}"{% if block.settings.src_srcset != "" %} srcset="{{ block.settings.src_srcset }}" sizes="(max-width: 800px) 100vw, 800px"{% endif %} alt="{{ block.settings.alt }}" loading="lazy">
  {% if block.settings.link != "" %}</a>{% endif %}
  {% if block.settings.caption != "" %}<figcaption>{{ block.settings.caption }}</figcaption>{% endif %}
</figure>
{% endif %}
