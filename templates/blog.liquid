<section class="sz-blog">
  <h1>{{ page.title }}</h1>
  {% if posts.size == 0 %}<p class="muted">{{ 'blog.empty' | t }}</p>{% endif %}
  <div class="sz-post-grid">
    {% for post in posts %}{% render 'post_card', post: post %}{% endfor %}
  </div>
  {% if pagination.prev_url != "" or pagination.next_url != "" %}
    <nav class="sz-pagination" aria-label="{{ 'blog.pagination' | t }}">
      {% if pagination.prev_url != "" %}<a href="{{ pagination.prev_url }}">{{ 'blog.newer' | t }}</a>{% endif %}
      {% if pagination.next_url != "" %}<a href="{{ pagination.next_url }}">{{ 'blog.older' | t }}</a>{% endif %}
    </nav>
  {% endif %}
</section>
