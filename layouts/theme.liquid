<!doctype html>
<html lang="{{ site.locale }}" class="font-{{ settings.font | default: 'sans' }}" style="--accent: {{ settings.accent_color | default: '#2563eb' }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ page_title }}</title>
  <link rel="stylesheet" href="{{ 'theme.css' | asset_url }}">
  {{ content_for_header }}
</head>
<body>
  {% render 'header' %}
  <main id="main">
    {{ content_for_layout }}
  </main>
  {% render 'footer' %}
</body>
</html>
