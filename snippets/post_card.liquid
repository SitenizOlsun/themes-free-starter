<article class="sz-post-card">
  {% if post.cover_url != "" %}
    <img src="{{ post.cover_url }}"{% if post.cover_srcset != "" %} srcset="{{ post.cover_srcset }}" sizes="(max-width: 800px) 100vw, 400px"{% endif %} alt="{{ post.cover_alt }}" loading="lazy">
  {% endif %}
  <h2><a href="{{ post.url }}">{{ post.title }}</a></h2>
  <p class="muted"><time datetime="{{ post.published_at }}">{{ post.published_at | date: "%d.%m.%Y" }}</time></p>
  {% if post.excerpt != "" %}<p>{{ post.excerpt }}</p>{% endif %}
</article>
